<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

  <display-name>LifeLink - Blood Donor Finder</display-name>

  <!-- Context parameters: read with getInitParameter() and shared by the whole application -->
  <context-param>
    <param-name>appName</param-name>
    <param-value>LifeLink</param-value>
  </context-param>

  <!-- Session management: sessions end after 30 idle minutes; cookie hidden from JavaScript -->
  <session-config>
    <session-timeout>30</session-timeout>
    <cookie-config>
      <http-only>true</http-only>
      <!-- Enable secure=true at the HTTPS production host/proxy; do not enable for plain-HTTP localhost. -->
    </cookie-config>
  </session-config>

  <welcome-file-list>
    <welcome-file>index.jsp</welcome-file>
  </welcome-file-list>

  <!-- Error handling: friendly pages instead of raw stack traces -->
  <error-page>
    <error-code>404</error-code>
    <location>/WEB-INF/views/error.jsp</location>
  </error-page>
  <error-page>
    <error-code>500</error-code>
    <location>/WEB-INF/views/error.jsp</location>
  </error-page>
  <error-page>
    <exception-type>java.lang.Throwable</exception-type>
    <location>/WEB-INF/views/error.jsp</location>
  </error-page>
</web-app>
